{
  "id": "/tapflow/",
  "name": "TapFlow — Engetap",
  "short_name": "TapFlow",
  "description": "A porta única do TapFlow: o Manager do escritório e o Field do inspetor, com um login só.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#F1F3F4",
  "theme_color": "#1B6FA9",
  "categories": ["business", "productivity"],
  "shortcuts": [
    { "name": "Manager", "short_name": "Manager", "url": "./manager/",
      "description": "Quadros, cadastros, propostas e OS" },
    { "name": "Field",   "short_name": "Field",   "url": "./field/",
      "description": "O app do inspetor, com fila offline" }
  ],
  "icons": [
    { "src": "field/icons/icon-192.png",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "field/icons/icon-512.png",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "field/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
